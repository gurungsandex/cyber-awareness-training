# ─── CyberShield environment configuration ───────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.

# ── Database (required) ───────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev with the docker-compose stack the
# host is `postgres`; for a host-installed Postgres use `localhost`.
DATABASE_URL="postgresql://cybershield:cybershield_change_me@localhost:5432/cybershield?schema=public"

# ── Auth (required) ───────────────────────────────────────────────────────────
# NextAuth secret used to sign JWT sessions. Generate a strong random value:
#   openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_a_32_plus_char_random_secret"
# Public URL the app is served from (used for auth callbacks).
NEXTAUTH_URL="http://localhost:3000"

# ── Background jobs / Redis (required for workers) ────────────────────────────
# Campaign launches, remediation, new-hire onboarding and certificate generation
# run on BullMQ. With docker-compose the host is `redis`.
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── Certificate storage (optional) ────────────────────────────────────────────
# Directory where generated certificate PDFs are written. Kept OUTSIDE public/
# so they are only downloadable via the authenticated /api/certificates/[id]
# route. Defaults to <cwd>/storage/certificates. Point at a mounted volume in
# production so certificates survive redeploys.
# CERT_STORAGE_DIR="/app/storage/certificates"

# ── Logging (optional) ────────────────────────────────────────────────────────
# Minimum level emitted by the structured logger: debug | info | warn | error.
# Defaults to `info` in production and `debug` otherwise.
# LOG_LEVEL="info"

# ── Seed overrides (optional) ─────────────────────────────────────────────────
# Override the default seeded admin account. Change these before seeding prod.
# SEED_ADMIN_EMAIL="admin@yourorg.local"
# SEED_ADMIN_PASSWORD="a-strong-admin-password"

# ── AI content generation (optional) ──────────────────────────────────────────
# Anthropic API key for AI-assisted content generation. Leave blank to disable;
# the platform degrades gracefully and all features work without it.
# ANTHROPIC_API_KEY=""
