# CyberShield — required environment variables
# Copy this file to .env and fill in real values before running.

# PostgreSQL connection string
DATABASE_URL="postgresql://cybershield:CHANGE_ME@localhost:5432/cybershield"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_32_CHAR_MINIMUM"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="https://your-domain.example.com"

# Redis connection (docker-compose sets REDIS_HOST + REDIS_PORT; for standalone use REDIS_URL)
REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional: Anthropic API key for AI-generated course content
ANTHROPIC_API_KEY=""
